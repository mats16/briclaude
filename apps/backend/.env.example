# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Encryption (optional - leave empty for plaintext mode, NOT recommended for production)
ENCRYPTION_KEY=

# Databricks (required)
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# Databricks Apps (optional - automatically set in Databricks Apps environment)
DATABRICKS_APP_NAME=
DATABRICKS_WORKSPACE_ID=
DATABRICKS_APP_PORT=8000
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# SQL Warehouse IDs (optional)
WAREHOUSE_ID_2XS=
WAREHOUSE_ID_XS=
WAREHOUSE_ID_S=

# Anthropic API (optional - defaults to Databricks serving endpoints)
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_OPUS_MODEL=databricks-claude-opus-4-5
ANTHROPIC_DEFAULT_SONNET_MODEL=databricks-claude-sonnet-4-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=databricks-claude-haiku-4-5

# User directories (optional)
USER_BASE_DIR=
SESSION_BASE_DIR=

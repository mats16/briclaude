    "@repo/types": "*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
